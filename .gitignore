/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor

# Local SQLite created during smoke-testing
/database/database.sqlite
/database/*.sqlite-journal

# Runtime logs (keep the directory, drop the contents)
/storage/logs/*.log

# Compiled / cached framework artifacts (keep the directories)
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
!/storage/framework/cache/data/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep

# Local imports / temp uploads
/storage/app/private/imports/*
!/storage/app/private/imports/.gitkeep
/storage/app/imports/*
!/storage/app/imports/.gitkeep
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
/.zed
.DS_Store
