# =========================================================================
#  lodgely — environment configuration
#  All values below are safe defaults for local Docker development.
#  See README.md for production hardening notes.
# =========================================================================

APP_NAME=lodgely
APP_ENV=local
APP_KEY=                              # Run: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080         # Set to your public URL (e.g. https://lodgely.example.com)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Docker port mapping --------------------------------------------------
# Host ports that Caddy binds on. Change if these are already in use.
LODGELY_HTTP_PORT=8080
LODGELY_HTTPS_PORT=8443

# --- Branding (kept generic; do not hard-code customer names anywhere) ---
LODGELY_BRAND_NAME="lodgely"
LODGELY_BRAND_TAGLINE="Lead intake, unified."
# Note: the footer "GitHub" link target is hardcoded in config/lodgely.php to the
# upstream repository as part of GPL-3.0 attribution. It is intentionally not
# configurable via .env.

# --- Database (PostgreSQL 16) ---------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432                    # Internal Docker port — does not affect your host machine
DB_DATABASE=lodgely
DB_USERNAME=lodgely
DB_PASSWORD=lodgely             # Change this; must match what postgres was initialised with

# --- Security -------------------------------------------------------------
# Which proxies to trust for X-Forwarded-* headers. '*' (the default) trusts
# every proxy, which means the client IP is whatever the caller puts in the
# header — fine on a laptop, wrong on the public internet. Set this to your
# reverse proxy's address or CIDR; for the bundled Docker stack that is the
# default bridge network. Comma-separated for several.
#TRUSTED_PROXIES=172.16.0.0/12

# --- Backups --------------------------------------------------------------
# A backup archive holds every lead's name, email, phone and message body in
# cleartext. Set a passphrase to encrypt the database dump inside NEW archives
# (AES-256-GCM). Archives created before you set this keep restoring normally.
# Keep the passphrase somewhere other than this server — without it an
# encrypted archive cannot be restored.
#LODGELY_BACKUP_PASSPHRASE=

# How many backup archives to keep on disk. Empty (the default) keeps every
# archive forever; each one is a full copy of your data that outlives the
# retention window, so pick a number once you have somewhere else to store them.
#LODGELY_BACKUP_KEEP=14

# --- Session / Cache / Queue ---------------------------------------------
SESSION_DRIVER=file             # 'file' is simplest; switch to 'database' once DB is confirmed working
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false     # Set to true when serving over HTTPS (including behind Cloudflare/nginx)
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Filesystem (local first, S3-compatible later) ------------------------
FILESYSTEM_DISK=local

# --- Mail (log driver in MVP; switch to smtp in production) --------------
# Outbound email can also be configured in the UI under Settings → Email
# (operator-only). Settings saved there are stored encrypted and OVERRIDE the
# values below — handy when you can't edit .env. Use these vars only if you
# prefer file-based config.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@lodgely.local"
MAIL_FROM_NAME="${APP_NAME}"
# SMTP example (set MAIL_MAILER=smtp to send for real):
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=leads@example.com
# MAIL_PASSWORD=
# MAIL_SCHEME=smtp          # smtp = STARTTLS (port 587); smtps = implicit TLS (port 465)

# --- Importers ------------------------------------------------------------
LODGELY_CSV_MAX_ROWS=10000
LODGELY_EMAIL_IMPORT_DRIVER=mock   # mock | imap
# Daily 06:00 scheduled pull of fake demo leads. Off by default — turn on only
# for demo/dev installs. The manual `lodgely:import:email-mock` command and the
# in-app "pull now" button generate mock leads regardless of this flag.
LODGELY_EMAIL_MOCK_SCHEDULE=false

# --- Google Sheets OAuth --------------------------------------------------
# OAuth installed-application credentials for the Google Sheets v4 API.
# 1. Create an OAuth 2.0 Client (type "Web application") in Google Cloud Console.
# 2. Add this app's callback as an authorized redirect URI:
#      ${APP_URL}/settings/google-sheets/callback
# 3. Set CLIENT_ID and CLIENT_SECRET below, then (as an operator) visit
#      ${APP_URL}/settings/google-sheets/connect
#    to run the consent flow. The app will display a refresh token; paste it
#    back here as LODGELY_GOOGLE_SHEETS_REFRESH_TOKEN.
# LODGELY_GOOGLE_SHEETS_CLIENT_ID=
# LODGELY_GOOGLE_SHEETS_CLIENT_SECRET=
# LODGELY_GOOGLE_SHEETS_REFRESH_TOKEN=
# LODGELY_GOOGLE_SHEETS_HTTP_TIMEOUT=30

# --- OpenFlow lead source (per-source URL + login configured at /imports/openflow) ---
# LODGELY_OPENFLOW_HTTP_TIMEOUT=30

# --- IMAP (set LODGELY_EMAIL_IMPORT_DRIVER=imap to activate) ---------------
# LODGELY_IMAP_HOST=mail.example.com
# LODGELY_IMAP_PORT=993
# LODGELY_IMAP_ENCRYPTION=ssl          # ssl | tls | notls
# LODGELY_IMAP_VALIDATE_CERT=true
# LODGELY_IMAP_USERNAME=leads@example.com
# LODGELY_IMAP_PASSWORD=
# LODGELY_IMAP_MAILBOX=INBOX
# LODGELY_IMAP_MAX_MESSAGES=50         # max unseen messages per pull
# LODGELY_IMAP_DEFAULT_CLIENT=         # pre-fill client_name on ingested leads
# LODGELY_IMAP_DEFAULT_CAMPAIGN=       # pre-fill campaign_name on ingested leads

# --- Compliance defaults --------------------------------------------------
# Default retention window (days) applied to newly ingested leads.
# Null/empty = no automatic retention; cleanup job is opt-in.
LODGELY_DEFAULT_RETENTION_DAYS=365

# --- Ad metrics reporting -------------------------------------------------
# Comma-separated list of ad source adapter keys to run. Mocks ship deterministic
# demo data; swap to 'meta,google' once the credentials below are configured.
# Available: meta_mock, google_mock, meta, google.
LODGELY_AD_METRICS_SOURCES=meta_mock,google_mock
# HTTP timeout (seconds) for outbound ad platform calls.
LODGELY_AD_METRICS_HTTP_TIMEOUT=30
# How many days the reporting page's "Fetch data now" button backfills at once.
LODGELY_AD_METRICS_BACKFILL_DAYS=30

# --- Meta (Facebook/Instagram) Marketing API ------------------------------
# Required when 'meta' is listed in LODGELY_AD_METRICS_SOURCES.
# Generate a long-lived system-user access token in Meta Business Manager.
# LODGELY_META_ADS_ACCESS_TOKEN=
# LODGELY_META_ADS_ACCOUNT_ID=          # ad account id, with or without the 'act_' prefix
# LODGELY_META_ADS_API_VERSION=v21.0
# LODGELY_META_ADS_CURRENCY=USD         # must match the ad account currency

# --- Google Ads REST API --------------------------------------------------
# Required when 'google' is listed in LODGELY_AD_METRICS_SOURCES.
# Needs an approved developer token + an OAuth installed-app refresh token.
# LODGELY_GOOGLE_ADS_CLIENT_ID=
# LODGELY_GOOGLE_ADS_CLIENT_SECRET=
# LODGELY_GOOGLE_ADS_REFRESH_TOKEN=
# LODGELY_GOOGLE_ADS_DEVELOPER_TOKEN=
# LODGELY_GOOGLE_ADS_LOGIN_CUSTOMER_ID= # only set when auth'd via a manager (MCC) account
# LODGELY_GOOGLE_ADS_CUSTOMER_ID=       # target account id, digits only or hyphenated
# LODGELY_GOOGLE_ADS_API_VERSION=v18

# --- AI summaries (off by default) ----------------------------------------
# Master kill-switch. When false, AI routes 404 and buttons are hidden.
# Per-tenant configuration is then edited at /settings/ai (operator only).
LODGELY_AI_ENABLED=false
# Maximum completed AI generations per tenant per day (0 disables the cap).
LODGELY_AI_MAX_CALLS_PER_DAY=100
# HTTP timeout for a single provider call, in seconds.
LODGELY_AI_TIMEOUT=60

# --- Logging --------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=error
