# =========================================================================
#  lodgely — environment configuration
#  All values below are safe defaults for local Docker development.
#  See README.md for production hardening notes.
# =========================================================================

APP_NAME=lodgely
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Branding (kept generic; do not hard-code customer names anywhere) ---
LODGELY_BRAND_NAME="lodgely"
LODGELY_BRAND_TAGLINE="Lead intake, unified."

# --- Database (PostgreSQL 16) ---------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lodgely
DB_USERNAME=lodgely
DB_PASSWORD=lodgely

# --- Session / Cache / Queue ---------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Filesystem (local first, S3-compatible later) ------------------------
FILESYSTEM_DISK=local

# --- Mail (log driver in MVP; switch to smtp in production) --------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@lodgely.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Importers ------------------------------------------------------------
LODGELY_CSV_MAX_ROWS=10000
LODGELY_EMAIL_IMPORT_DRIVER=mock   # mock | imap

# --- IMAP (set LODGELY_EMAIL_IMPORT_DRIVER=imap to activate) ---------------
# LODGELY_IMAP_HOST=mail.example.com
# LODGELY_IMAP_PORT=993
# LODGELY_IMAP_ENCRYPTION=ssl          # ssl | tls | notls
# LODGELY_IMAP_VALIDATE_CERT=true
# LODGELY_IMAP_USERNAME=leads@example.com
# LODGELY_IMAP_PASSWORD=secret
# LODGELY_IMAP_MAILBOX=INBOX
# LODGELY_IMAP_MAX_MESSAGES=50         # max unseen messages per pull
# LODGELY_IMAP_DEFAULT_CLIENT=         # pre-fill client_name on ingested leads
# LODGELY_IMAP_DEFAULT_CAMPAIGN=       # pre-fill campaign_name on ingested leads

# --- Compliance defaults --------------------------------------------------
# Default retention window (days) applied to newly ingested leads.
# Null/empty = no automatic retention; cleanup job is opt-in.
LODGELY_DEFAULT_RETENTION_DAYS=365

# --- Logging --------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
